{
  "name": "is-architect-quest-desktop",
  "version": "1.0.0",
  "description": "เกม 2D Vector SVG จำแนกประเภทของระบบสารสนเทศ (TPS, OAS, MIS, DSS, EIS, ES) สำหรับนักศึกษาชั้นปีที่ 2 ตอบตัวชี้วัดหลักสูตรแกนกลาง 2560 (Vite + Node.js + SQLite + Electron)",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "server": "node backend/server.js",
    "dev:vite": "vite --port 5173",
    "dev": "concurrently -k \"npm run server\" \"npm run dev:vite\"",
    "electron:dev": "concurrently -k \"npm run dev:vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build": "vite build",
    "electron:start": "vite build && electron ."
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "vite": "^6.0.1",
    "wait-on": "^8.0.1"
  }
}
